  "space": {
    "$type": "dimension",
    "$description": "8-point scale, t-shirt sized. Use only these steps. Tailwind equivalents in brackets: 2xs(1) xs(2) s(4) m(6) l(8) xl(12) 2xl(20). Spacing grows as you move outwards: small inside groups, large between sections.",
    "unit": {
      "$value": "0.25rem",
      "$description": "Tailwind base unit: p-4 = 1rem"
    },
    "2xs": {
      "$value": "0.25rem",
      "$description": "4 px - icon to label, label to its hint"
    },
    "xs": {
      "$value": "0.5rem",
      "$description": "8 px - tightly related: label to input, lines in a card"
    },
    "s": {
      "$value": "1rem",
      "$description": "16 px - between fields, between buttons"
    },
    "m": {
      "$value": "1.5rem",
      "$description": "24 px - card padding, between groups"
    },
    "l": {
      "$value": "2rem",
      "$description": "32 px - grid gutters on desktop, between cards"
    },
    "xl": {
      "$value": "3rem",
      "$description": "48 px - between sections inside a page"
    },
    "2xl": {
      "$value": "5rem",
      "$description": "80 px - between major page sections, desktop side margins"
    },
    "card": {
      "$value": "1.5rem",
      "$description": "Card padding; follows density (compact 16, comfortable 24, spacious 32)."
    }
  },
  "size": {
    "$type": "dimension",
    "control-sm": {
      "$value": "2.25rem",
      "$description": "36 px visual height - dense desktop UIs only; hit area extended to 44 px"
    },
    "control-md": {
      "$value": "2.75rem",
      "$description": "44 px - default buttons and inputs"
    },
    "control-lg": {
      "$value": "3rem",
      "$description": "48 px - touch-first screens, primary calls to action"
    },
    "touch": {
      "$value": "3rem",
      "$description": "48 px - minimum target for touch, also steppers and icon buttons"
    },
    "measure": {
      "$value": "68ch",
      "$description": "Comfortable maximum line length for body text"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Scale (sm-xl, full) plus roles. Components use the roles, so themes can change shape in one place.",
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.625rem"
    },
    "xl": {
      "$value": "1rem"
    },
    "full": {
      "$value": "9999px"
    },
    "control": {
      "$value": "0.375rem",
      "$description": "Buttons, inputs, steppers"
    },
    "check": {
      "$value": "0.25rem",
      "$description": "Checkbox boxes"
    },
    "card": {
      "$value": "0.625rem",
      "$description": "Cards and panels"
    },
    "dialog": {
      "$value": "1rem",
      "$description": "Dialogs and large floating surfaces"
    },
    "badge": {
      "$value": "9999px",
      "$description": "Status badges (pill, so they never look like buttons)"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Only for things that float: menus, popovers, dialogs. Flat content gets borders, not shadows.",
    "sm": {
      "$value": "0 1px 2px oklch(0.2 0.01 85 / 0.06), 0 1px 1px oklch(0.2 0.01 85 / 0.04)",
      "$extensions": {
        "everyday-ui": {
          "dark": "0 1px 2px oklch(0 0 0 / 0.5)"
        }
      }
    },
    "md": {
      "$value": "0 4px 12px -2px oklch(0.2 0.01 85 / 0.10), 0 2px 4px -2px oklch(0.2 0.01 85 / 0.06)",
      "$extensions": {
        "everyday-ui": {
          "dark": "0 4px 12px -2px oklch(0 0 0 / 0.6), 0 0 0 1px oklch(1 0 0 / 0.06)"
        }
      }
    },
    "lg": {
      "$value": "0 16px 40px -8px oklch(0.2 0.01 85 / 0.18), 0 4px 10px -4px oklch(0.2 0.01 85 / 0.08)",
      "$extensions": {
        "everyday-ui": {
          "dark": "0 16px 40px -8px oklch(0 0 0 / 0.7), 0 0 0 1px oklch(1 0 0 / 0.08)"
        }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "80ms",
        "$description": "Pressed states, toggles"
      },
      "fast": {
        "$value": "140ms",
        "$description": "Hover, small reveals"
      },
      "base": {
        "$value": "240ms",
        "$description": "Popovers, dialogs entering"
      },
      "slow": {
        "$value": "360ms",
        "$description": "Large surfaces, page-level transitions"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Entering elements: fast start, gentle settle"
      },
      "in": {
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "Exiting elements"
      },
      "in-out": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ],
        "$description": "Moving between two on-screen positions"
      }
    },
    "spring": {
      "$description": "Spring feel for animations driven by JS (Motion). bounce 0 = no overshoot; playful themes use a little.",
      "bounce": {
        "$type": "number",
        "$value": 0
      }
    },
    "distance": {
      "$type": "dimension",
      "$value": "0.625rem",
      "$description": "How far elements travel when they enter or leave (small: motion hints, it does not perform)."
    },
    "scale": {
      "$type": "number",
      "$value": 1,
      "$description": "Scale an entering element starts from (1 = no scaling; playful themes pop in from slightly smaller)."
    },
    "press": {
      "$type": "number",
      "$value": 0.98,
      "$description": "Scale of a pressed button or control (tactile feedback)."
    }
  },
  "$extensions": {
    "everyday-ui": {
      "defaultMode": "system",
      "contrast": "standard",
      "theme": "neutral"
    }
  },
  "shape": {
    "corner": {
      "$value": "round",
      "$description": "round | squircle. Squircle uses CSS corner-shape where supported and falls back to round."
    }
  },
  "effect": {
    "overlay-blur": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Backdrop blur behind floating surfaces; >0 only in glass themes."
    }
  }
}
