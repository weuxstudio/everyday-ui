  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Hanken Grotesk",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "SIL Open Font License; load it in the app or fall back to system UI"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      },
      "display": {
        "$value": [
          "Hanken Grotesk",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Headings. Same as sans by default; a theme may set a display face for personality."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "$description": "Two weights in practice: regular for text, semibold for emphasis (headings, labels, buttons). bold only for display sizes if the typeface needs it.",
      "heading": {
        "$value": 600,
        "$description": "Weight used for headings (h1-h4, card and dialog titles)."
      }
    }
  },
