{
  "name": "@everyday-ui/tokens",
  "version": "0.5.1",
  "description": "Framework-agnostic design tokens and theme generator for Everyday UI: CSS variables, Tailwind v4 theme, JS export. Contrast-checked (WCAG 2.2 + APCA) at build time.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./source.json": "./src/tokens.json",
    "./themes/*": "./dist/themes/*"
  },
  "files": [
    "dist",
    "src",
    "lib",
    "bin",
    "presets"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "report": "node scripts/build.mjs --report"
  },
  "bin": {
    "everyday-theme": "./bin/everyday-theme.mjs"
  }
}
